# 复制为 .env 并按需修改（.env 已被 gitignore），主要用于 docker compose。

# JWT 签名密钥：生产必须更换！
JWT_SIGNING_KEY=dev_only_change_me_in_prod

# MinIO 工作桶名（core 首次上传时自动建桶并设匿名只读）
OSS_BUCKET=shortplay
# 客户端访问 MinIO 的对外端点（拼对象键生成播放/封面 URL）
OSS_PUBLIC_ENDPOINT=http://localhost:9000

# 第三方依赖复用宿主机既有容器，连接参数在
# app/core/service/configs/{data,oss}.yaml 中支持环境变量覆盖：
#   DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME
#   REDIS_ADDR / REDIS_PASSWORD
#   OSS_ENDPOINT / OSS_ACCESS_KEY / OSS_SECRET_KEY
