# ============================================================
# go-wind-shortplay 后端环境变量模板
#
# 用法：复制为 backend/.env（已被 gitignore，严禁提交真实值）。
#   - `make run` / `make build`：经 app.mk 自动装载本文件（服务目录下
#     的 .env 可同名覆盖）；make test 同样生效。
#   - docker compose：compose 自动读取本文件做 ${VAR} 插值。
#   - 占位符解析：pkg/configenv 注册的 env 配置源使各服务 configs/*.yaml
#     中 `${VAR:default}` 按「环境变量优先、缺省值兜底」生效。
# ============================================================

# ── 工程标识（docker build / 镜像命名） ──────────────────────────
PROJECT_NAME=go-wind-shortplay
SERVICE_APP_VERSION=1.0.0

# ── 认证密钥 ────────────────────────────────────────────────────
# JWT 签名密钥：三服务必须一致；生产必须更换（dev 缺省仅限本地）。
JWT_SIGNING_KEY=dev_only_change_me_in_prod
# 登录密码传输加密密钥（AES-CBC，key=iv，须 16/24/32 字节）。
# 基座公开 dev 缺省 f51d66a73d8a0927（16 字节）仅限本地；生产必须更换，
# 且必须与前端 VITE_AES_KEY（frontend/admin/.env）同步一致。
# AES_KEY=f51d66a73d8a0927
# 凭据类字段落库加密总开关（AES-256-GCM，core 与 admin 必须一致）；
# 未设置时降级明文存储并告警，生产必须配置（可用 `openssl rand -hex 32` 生成）。
# ENCRYPTION_KEY=

# ── PostgreSQL（Citus，core 服务连接） ──────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=please_change_me
DB_NAME=shortplay

# ── Redis（验证码/缓存/队列） ───────────────────────────────────
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=please_change_me
# asynq 任务队列专用 URI（密码内嵌，当前指向 db2 专库，避免与其它项目
# 共用 db1 队列互相抢任务）。缺省随 REDIS_PASSWORD 不联动，需整体给出。
ASYNQ_REDIS_URI=redis://:please_change_me@127.0.0.1:6379/2

# ── MinIO（对象存储/媒体） ──────────────────────────────────────
OSS_ENDPOINT=127.0.0.1:9000
OSS_ACCESS_KEY=root
OSS_SECRET_KEY=please_change_me
# 客户端访问 MinIO 的对外端点（拼对象键生成播放/封面 URL）
OSS_PUBLIC_ENDPOINT=http://localhost:9000

# ── 可选集成（均含合理缺省，不配则功能关闭） ──────────────────────
# OIDC 登录：OIDC_ISSUER / OIDC_CLIENT_ID / OIDC_CLIENT_SECRET /
#   OIDC_AUTHORIZE_URL / OIDC_TOKEN_URL / OIDC_USERINFO_URL / OIDC_SCOPES
# SMTP 邮件：SMTP_HOST / SMTP_PORT / SMTP_USERNAME / SMTP_PASSWORD / SMTP_FROM / SMTP_TLS
# 站点外链（邮件正文等）：SITE_URL
# 媒体下载 Host 覆盖：OSS_DOWNLOAD_HOST
