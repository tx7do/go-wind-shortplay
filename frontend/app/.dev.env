# API 网关地址（app BFF，:6700）
# 安卓模拟器：10.0.2.2 映射宿主机；iOS 模拟器：127.0.0.1；真机：宿主机局域网 IP
# 亦可用 --dart-define=API_BASE=... 覆盖
API_BASE_URL="http://10.0.2.2:6700"

# 媒体（MinIO）公开访问地址：后端返回对象键（videos/...），播放/封面需拼接此前缀
# 端口与 bucket 见 backend：docker-compose.libs.yaml（9100）与 pkg/oss（默认 bucket=shortplay）
MEDIA_BASE_URL="http://10.0.2.2:9100/shortplay"

# 连接超时时间（秒）
CONNECTION_TIMEOUT=15
# 接受数据等待超时时间（秒）
RECEIVE_TIMEOUT=30
