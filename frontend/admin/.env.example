# ============================================================
# 管理后台（frontend/admin）环境变量模板
#
# 约定：本文件提交入库，不含真实值；本地差异写在 .env（已被
# gitignore，放密钥类变量，如 VITE_AES_KEY），环境差异写在
# .env.development / .env.production。
# ============================================================

# 运行环境标识：dev / test / pre / prod
VITE_ENV=dev

# dev server 端口（后端 CORS 白名单默认只放行 localhost:16800，换端口需同步改
# backend/app/admin/service/configs/server.yaml）
VITE_SERVER_PORT=16800

# dev 代理：/admin 前缀请求由 vite 转发到后端 admin BFF，规避 CORS
VITE_PROXY='[["/admin", "http://127.0.0.1:7600/"]]'

# API 基础地址：dev 设 "/"（走上方代理）；生产填后端对外地址
VITE_API_URL=/

# 通知 SSE 端点（admin BFF 独立 SSE 端口 :7601）
VITE_SSE_URL=http://localhost:7601/events

# 应用展示与缓存命名空间
VITE_APP_TITLE="GoWind 短视频社区 · 管理后台"
VITE_APP_NAMESPACE="gowind-shortplay"
VITE_APP_VERSION="1.0.0"
VITE_ANALYZE=false

# ── 密钥类：放本地 .env，勿提交 ─────────────────────────────────
# 登录密码传输加密密钥（AES-128-CBC，key=iv，16 字节）。
# 必须与后端 AES_KEY 环境变量一致（见 backend/.env.example）；
# 未设置时回退基座公开 dev 缺省 f51d66a73d8a0927，仅限本地开发。
# VITE_AES_KEY=f51d66a73d8a0927
